From ddc96456017c05e8ec56f93b99e7299d6c132cf2 Mon Sep 17 00:00:00 2001
From: dardiao <xn--6s1a@outlook.com>
Date: Sun, 20 Sep 2026 01:54:07 +0800
Subject: [PATCH 13/14] local: link the signup hint to the domain registration
 page

When the subdomain is not registered yet, the hint now makes "HapDNS" a link to the
registration page (https://hapdns.com/domains/) and opens it in a new tab, so the visitor can
register the name without losing the half-filled form. The message is split into text + link +
tail in config.ts, next to the other site-specific strings.
---
 .../components/home/authenticate/signup.tsx   | 25 +++++++++++++++++--
 src/shared/utils/config.ts                    |  7 +++++-
 2 files changed, 29 insertions(+), 3 deletions(-)

diff --git a/src/shared/components/home/authenticate/signup.tsx b/src/shared/components/home/authenticate/signup.tsx
index 2381844f..e027dffc 100644
--- a/src/shared/components/home/authenticate/signup.tsx
+++ b/src/shared/components/home/authenticate/signup.tsx
@@ -40,6 +40,9 @@ import { removeLocalStorageMarkdown } from "@components/common/markdown-textarea
 type DomainCheck = {
   state: "checking" | "ok" | "bad" | "unavailable";
   message?: string;
+  // optional inline link + trailing text, used to point at the dns platform
+  link?: { text: string; href: string };
+  tail?: string;
 };
 
 interface State {
@@ -458,10 +461,16 @@ async function checkSignupDomain(i: Signup) {
     const data = (await res.json()) as { status?: string; reason?: string };
     if (data.status === "registered") {
       i.state.domainCheck = { state: "ok", message: domainCheckMessages.ok };
+    } else if (data.reason) {
+      // the platform explained why (a reserved prefix, for example): show it as-is
+      i.state.domainCheck = { state: "bad", message: data.reason };
     } else {
+      const hint = domainCheckMessages.unregistered;
       i.state.domainCheck = {
         state: "bad",
-        message: data.reason ?? domainCheckMessages.unregistered,
+        message: hint.text,
+        link: hint.link,
+        tail: hint.tail,
       };
     }
   } catch {
@@ -484,7 +493,19 @@ function domainCheckHint(i: Signup) {
       : check.state === "bad"
         ? "text-danger"
         : "text-warning";
-  return <div className={`form-text ${cls}`}>{check.message}</div>;
+  return (
+    <div className={`form-text ${cls}`}>
+      {check.message}
+      {check.link && (
+        <>
+          <a href={check.link.href} target="_blank" rel="noopener noreferrer">
+            {check.link.text}
+          </a>
+          {check.tail}
+        </>
+      )}
+    </div>
+  );
 }
 
 function handleRegisterEmailChange(
diff --git a/src/shared/utils/config.ts b/src/shared/utils/config.ts
index a82a5b15..aa13532f 100644
--- a/src/shared/utils/config.ts
+++ b/src/shared/utils/config.ts
@@ -21,10 +21,15 @@ export const domainCheckPath = "/domain-check";
 export const domainCheckMessages = {
   checking: "正在校验子域名…",
   ok: "子域名已注册 ✅",
-  unregistered: "这个子域名还没有注册，请先去 HapDNS 注册",
   // Lemmy 用户名只允许字母、数字、下划线，长度 2~20；带连字符的子域名不能作为用户名。
   invalid: "只能用字母、数字、下划线，长度 2~20（连字符不支持）",
   unavailable: "暂时无法校验，提交后由管理员核对",
+  // 未注册时的提示：中间那段是可点击的链接，直接跳到 HapDNS 的域名注册页。
+  unregistered: {
+    text: "这个子域名还没有注册，请先去 ",
+    link: { text: "HapDNS", href: "https://hapdns.com/domains/" },
+    tail: " 注册",
+  },
 };
 
 export const postRefetchSeconds: number = 60 * 1000;
