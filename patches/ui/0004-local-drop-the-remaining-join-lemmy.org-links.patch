-    <a
-      className="sort-select-icon text-muted ms-2"
-      href={sortingHelpUrl}
-      rel={relTags}
-      title={I18NextService.i18n.t("sorting_help")}
-    >
-      <Icon icon="help-circle" classes="icon-inline" />
-    </a>
-  );
-}
+// LOCAL: upstream renders a "?" next to each sort dropdown that links to the official
+// sorting documentation; removed so the UI carries no links to join-lemmy.org.
