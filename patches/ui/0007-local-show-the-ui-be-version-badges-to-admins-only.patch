From e66ed057d85dbfcda736bef92448f2147fa59718 Mon Sep 17 00:00:00 2001
From: dardiao <xn--6s1a@outlook.com>
Date: Sat, 19 Sep 2026 22:29:33 +0800
Subject: [PATCH 07/14] local: show the ui/be version badges to admins only

The footer printed "UI: <ui version>  BE: <backend version>" to everyone. That hint is useful
while debugging a local stack, but on a public site it is developer noise - and it also
advertises that the backend runs a beta. Admins still see it.

The footer reads myUserInfo through setIsoData(), the same way other components do, so no
extra props have to be threaded through app.tsx.
---
 src/shared/components/app/footer.tsx | 28 +++++++++++++++++++++-------
 1 file changed, 21 insertions(+), 7 deletions(-)

diff --git a/src/shared/components/app/footer.tsx b/src/shared/components/app/footer.tsx
index 2503cf0d..a40889ae 100644
--- a/src/shared/components/app/footer.tsx
+++ b/src/shared/components/app/footer.tsx
@@ -2,6 +2,8 @@ import { Component } from "inferno";
 import { NavLink } from "inferno-router";
 import { GetSiteResponse } from "lemmy-js-client";
 import { instanceLabel } from "@utils/config";
+import { setIsoData } from "@utils/app";
+import { amAdmin } from "@utils/roles";
 import { I18NextService } from "../../services";
 import { VERSION } from "../../version";
 
@@ -10,19 +12,31 @@ interface FooterProps {
 }
 
 export class Footer extends Component<FooterProps, never> {
+  private isoData = setIsoData(this.context);
+
   render() {
+    // LOCAL: the UI/BE version badges are useful when debugging but are developer noise on a
+    // public site, so only admins see them.
+    const showVersions = amAdmin(this.isoData.myUserInfo);
+
     return (
       <footer className="app-footer container-lg navbar navbar-expand-md navbar-light navbar-bg p-3">
         <div className="navbar-collapse">
           <ul className="navbar-nav ms-auto">
-            {this.props.site?.version !== VERSION && (
-              <li className="nav-item">
-                <span className="nav-link">UI: {VERSION}</span>
-              </li>
+            {showVersions && (
+              <>
+                {this.props.site?.version !== VERSION && (
+                  <li className="nav-item">
+                    <span className="nav-link">UI: {VERSION}</span>
+                  </li>
+                )}
+                <li className="nav-item">
+                  <span className="nav-link">
+                    BE: {this.props.site?.version}
+                  </span>
+                </li>
+              </>
             )}
-            <li className="nav-item">
-              <span className="nav-link">BE: {this.props.site?.version}</span>
-            </li>
             <li className="nav-item">
               <NavLink className="nav-link" to="/modlog">
                 {I18NextService.i18n.t("modlog")}
-- 
