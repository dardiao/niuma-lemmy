-    <meta name="Description" content="Lemmy">
+    <meta name="Description" content="${(site?.site_view.site.name ?? "").replace(/"/g, "&quot;")}">
     <meta charset="utf-8">
     <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
     <link
