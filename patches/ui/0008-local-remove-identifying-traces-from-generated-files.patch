From 225ab04f488ce88b23fa353a15090cab52d75618 Mon Sep 17 00:00:00 2001
From: dardiao <xn--6s1a@outlook.com>
Date: Sat, 19 Sep 2026 22:38:52 +0800
Subject: [PATCH 08/15] local: remove identifying traces from generated files
 and pages

- webpack banner: keep the copyright line, the AGPL notice and a modification notice (all of
  which the licence asks for) but drop the link back to the upstream repository and the
  "Created by" line
- <meta name="Description"> said "Lemmy"; it now carries the site name
- the root div's class was "lemmy-site", a hook other tools can use to detect the software
- the API responses advertised "X-Powered-By: Express"
- security.txt pointed at the upstream security advisory page; it now uses
  LEMMY_UI_SECURITY_CONTACT and stays silent when that is unset
- dropped the four url constants nothing referenced any more (repoUrl, docsUrl, helpGuideUrl,
  sortingHelpUrl) so their strings stop shipping in the bundle
---
 src/server/handlers/security-handler.ts | 12 ++++++++++--
 src/server/index.tsx                    |  2 ++
 src/server/utils/create-ssr-html.tsx    |  2 +-
 src/shared/components/app/app.tsx       |  2 +-
 src/shared/utils/config.ts              |  4 ----
 webpack.config.js                       |  8 ++++++--
 6 files changed, 20 insertions(+), 10 deletions(-)

diff --git a/src/server/handlers/security-handler.ts b/src/server/handlers/security-handler.ts
index 8687ddc1..4237d647 100644
--- a/src/server/handlers/security-handler.ts
+++ b/src/server/handlers/security-handler.ts
@@ -2,6 +2,10 @@ import type { Response } from "express";
 import { BUILD_DATE_ISO8601 } from "../../shared/build-date";
 import { parseISO } from "date-fns";
 
+// LOCAL: upstream pointed this at its own security advisory page. Send reporters to the
+// operator instead: set LEMMY_UI_SECURITY_CONTACT (a uri, e.g. mailto:you@example.org) in the
+// deployment. With nothing configured only the Expires field is sent, so no report ever ends
+// up at the upstream project by accident.
 export default ({ res }: { res: Response }) => {
   const buildDatePlusYear = parseISO(BUILD_DATE_ISO8601);
 
@@ -12,6 +16,10 @@ export default ({ res }: { res: Response }) => {
 
   res.setHeader("content-type", "text/plain; charset=utf-8");
 
-  res.send(`Contact: https://github.com/LemmyNet/lemmy-ui/security/advisories/new
-Expires: ${yearFromNow}`);
+  const contact = process.env.LEMMY_UI_SECURITY_CONTACT;
+  res.send(
+    contact
+      ? `Contact: ${contact}\nExpires: ${yearFromNow}`
+      : `Expires: ${yearFromNow}`,
+  );
 };
diff --git a/src/server/index.tsx b/src/server/index.tsx
index ac6f314c..7d20b053 100644
--- a/src/server/index.tsx
+++ b/src/server/index.tsx
@@ -29,6 +29,8 @@ import {
 } from "./handlers/feed-handler";
 
 const server = express();
+// LOCAL: don't advertise the server framework in every response.
+server.disable("x-powered-by");
 // Log requests, skipping static asset paths to avoid log noise
 const logFormat =
   process.env["NODE_ENV"] === "development" ? "dev" : "combined";
