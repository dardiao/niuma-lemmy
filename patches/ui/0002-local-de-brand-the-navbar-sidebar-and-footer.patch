+
+// LOCAL: no browser exposes an API to add a bookmark, so use the share sheet where the
+// platform has one (it offers "add bookmark" on macOS) and otherwise copy the URL and tell
+// the user the keyboard shortcut.
+function bookmarkSite() {
+  const url = window.location.origin;
+  if (navigator.share) {
+    navigator.share({ title: document.title, url }).catch(() => undefined);
+  } else {
+    void navigator.clipboard
+      ?.writeText(url)
+      .then(() => alert(bookmarkHint(url)))
+      .catch(() => undefined);
+  }
+}
