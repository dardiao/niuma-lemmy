# 生产部署配置。复制成 .env 后填值：cp .env.example .env
# .env 里有密码，不要提交到 git、不要贴给别人。

# 站点域名（不带 https://）。DNS 的 A 记录要先指向服务器 IP，否则证书签不下来。
# 你的解析记录：mouth.niuma.club.  A  69.33.212.6
LEMMY_DOMAIN=mouth.niuma.club
# Let's Encrypt 通知邮箱
ACME_EMAIL=you@example.com

# 下面两个留空即可，write-config.sh 会自动生成 32 位随机串并写回本文件
POSTGRES_PASSWORD=
PICTRS_API_KEY=

# 安全联系地址，会写进 /.well-known/security.txt（RFC 9116 的 Contact 字段）
LEMMY_UI_SECURITY_CONTACT=mailto:you@example.com

# 首次建站的初始管理员。留空 = 首次打开网页时用建站向导自己填（推荐，密码不落盘）
ADMIN_USERNAME=niuma
ADMIN_PASSWORD=
SITE_NAME=牛马俱乐部

# 邮件：QQ 邮箱（hapdns.com 也是用这个）。不填的话用户无法重置密码，
# 注册申请也不会有邮件通知。
# ⚠️ SMTP_PASSWORD 填的是「授权码」，不是 QQ 登录密码：
#    QQ邮箱 → 设置 → 账户 → POP3/IMAP/SMTP服务 → 开启并生成授权码（16 位字母数字）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
# smtps = 465 端口隐式 TLS（推荐）；starttls = 587 端口显式 TLS
SMTP_TLS=smtps
SMTP_LOGIN=yourname@qq.com
SMTP_PASSWORD=
SMTP_FROM=yourname@qq.com

# 联邦开关：false = 正常和 fediverse 互通；true = 只做本地实例，不向外发送活动
LEMMY_DISABLE_ACTIVITY_SENDING=false
